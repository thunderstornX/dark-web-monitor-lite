# dark-web-monitor-lite — environment template
# Every key is optional. The matcher eval (the measured component)
# runs without any of them.

# Tor SOCKS5 proxy. Default points at a local Tor daemon. If unset
# or unreachable, the fetcher returns TOR_UNAVAILABLE and the report
# shows the coverage gap.
TOR_SOCKS_URL=socks5://127.0.0.1:9050

# Webhook URLs for alert dispatch. All optional; missing ones are
# skipped gracefully. NEVER commit a real webhook URL — the .env
# file is gitignored.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=

# rapidfuzz threshold for fuzzy matching (0..100). The matcher's
# default is 85; the eval reports both threshold settings.
FUZZY_THRESHOLD=85
